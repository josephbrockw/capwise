# Use a Node.js LTS version compatible with Expo
FROM node:18-alpine

# Set the working directory inside the container
WORKDIR /usr/src/app

# Install Expo CLI globally (optional, but can be helpful)
# RUN npm install --global expo-cli

# Copy package.json and package-lock.json first for layer caching
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy the rest of the application code
COPY . .

# Expo Metro Bundler runs on 8081 by default
# Expo Go connects via 19000 and 19001
# Expo Dev Tools via 19002
EXPOSE 8081 19000 19001 19002

# The command will be specified in docker-compose.yml
# CMD ["npm", "run", "start"]
